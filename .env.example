# Copy this file to .env and adjust as needed.
# Every value below has a working default in settings.py, so the app runs
# out of the box against SQLite with no external services required.

# --- Flask ---
# SECRET_KEY=supersecretkey
# Absolute path; defaults to <project root>/static.
# STATIC_FOLDER=

# --- App ---
# APP_NAME=Demongo
# APP_VERSION=0.0.1

# --- Site ---
# SITE_NAME=Demongo Site
# SITE_DESCRIPTION=This is the Demongo site.
# SITE_URL=http://localhost:5000

# --- Database ---
# Which of the blocks below builds SQLALCHEMY_DATABASE_URI: sqlite | mysql | postgresql
DATABASE_PROVIDER=sqlite

# SQLite (used when DATABASE_PROVIDER=sqlite)
# SQLITE_DATABASE_NAME=demongo.db

# MySQL (used when DATABASE_PROVIDER=mysql; install with `uv sync --extra mysql`)
# MYSQL_SERVER=localhost
# MYSQL_PORT=3306
# MYSQL_USERNAME=root
# MYSQL_PASSWORD=root
# MYSQL_DATABASE_NAME=demongo

# PostgreSQL (used when DATABASE_PROVIDER=postgresql; install with `uv sync --extra postgresql`)
# POSTGRESQL_SERVER=localhost
# POSTGRESQL_PORT=5432
# POSTGRESQL_USERNAME=postgres
# POSTGRESQL_PASSWORD=postgres
# POSTGRESQL_DATABASE_NAME=demongo

# Escape hatch: set this to override DATABASE_PROVIDER entirely with a raw URI.
# SQLALCHEMY_DATABASE_URI=

# SQLALCHEMY_TRACK_MODIFICATIONS=False

# --- Mail ---
# Leave MAIL_SERVER empty and mail is "sent" without a real SMTP connection —
# send_mail() just logs the subject/body instead. Fill these in to send for real.
# MAIL_SERVER=
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USE_SSL=False
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=no-reply@demongo.local
# MAIL_SUPPRESS_SEND=

# --- Redis (shared by cache, rate limiting, and the RQ queue) ---
# REDIS_URL=redis://localhost:6379/0

# --- Cache ---
# SimpleCache (in-process) by default — zero setup. Switch to RedisCache to
# share the cache across processes/workers.
# CACHE_TYPE=SimpleCache
# CACHE_DEFAULT_TIMEOUT=300
# CACHE_REDIS_URL=

# --- Rate limiting ---
# In-memory (per-process) by default. Switch to a redis:// URI in production
# so limits are shared across workers.
# RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_DEFAULT=200 per day;50 per hour

# --- i18n ---
# LANGUAGES=en,tr
# BABEL_DEFAULT_LOCALE=en
# BABEL_DEFAULT_TIMEZONE=UTC

# --- Uploads ---
# Max request body size Flask will accept, in bytes (413 above this).
# MAX_CONTENT_LENGTH=5242880
# UPLOAD_ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,webp,pdf
